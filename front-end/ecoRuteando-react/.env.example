# ==============================================================================
# EcoRuteando - Frontend Web (.env)
# Copiar este archivo a front-end/ecoRuteando-react/.env y configurar los valores.
# NOTA: Este archivo .env NUNCA debe incluirse en Git (está en .gitignore).
# ==============================================================================

# Google Maps Platform API Key (Clave específica para Web: EcoRuteando-Web)
# Requiere habilitar en Google Cloud Console: Maps JavaScript API y Places API.
# Se recomienda restringir la clave por HTTP Referrers (ej. http://localhost:5173/* y dominio de producción).
VITE_GOOGLE_MAPS_API_KEY=
